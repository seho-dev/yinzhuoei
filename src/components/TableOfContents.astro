---
import type { MarkdownHeading } from 'astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { headings: MarkdownHeading[]; lang: Lang }
const { headings, lang } = Astro.props;
const t = useTranslations(lang);
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 0 && (
  <nav class="toc" aria-label={t('post.toc')}>
    <p class="toc-title">{t('post.toc')}</p>
    <ol class="toc-list">
      {items.map((h) => (
        <li class:list={['toc-item', { sub: h.depth === 3 }]}>
          <a href={`#${h.slug}`} class="toc-link" data-toc-link={h.slug}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc {
    position: sticky;
    top: 6rem;
    font-size: 0.8125rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    scrollbar-width: none;
  }
  .toc-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.75rem;
  }
  .toc-list { list-style: none; padding: 0; margin: 0; }
  .toc-item { margin: 0; }
  .toc-item.sub { padding-left: 1rem; }
  .toc-link {
    display: block;
    padding: 0.28rem 0 0.28rem 0.85rem;
    color: var(--ink-3);
    border-left: 1.5px solid var(--line);
    line-height: 1.45;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .toc-item.sub .toc-link { font-size: 0.78rem; }
  .toc-link:hover { color: var(--ink); }
  .toc-link.active { color: var(--accent); border-left-color: var(--accent); }
</style>

<script>
  function bindToc() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    if (!links.length) return;
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => map.set(l.dataset.tocLink!, l));
    const headings = [...map.keys()]
      .map((slug) => document.getElementById(slug))
      .filter((el): el is HTMLElement => !!el);
    if (!headings.length) return;
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((l) => l.classList.remove('active'));
          map.get(e.target.id)?.classList.add('active');
        }
      },
      { rootMargin: '-10% 0px -75% 0px' },
    );
    headings.forEach((h) => spy.observe(h));
  }
  bindToc();
  document.addEventListener('astro:page-load', bindToc);
</script>

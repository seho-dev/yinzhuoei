---
/** MDX component: an aside for notes, warnings and tips. */
interface Props {
  type?: 'note' | 'tip' | 'warning';
  title?: string;
}
const { type = 'note', title } = Astro.props;
const labels = { note: 'Note', tip: 'Tip', warning: 'Warning' };
---
<aside class={`callout callout-${type}`} data-type={type}>
  <p class="callout-title">{title ?? labels[type]}</p>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    margin: 1.75em 0;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    border-radius: 0 8px 8px 0;
    background: var(--bg-subtle);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .callout-title {
    margin: 0 0 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .callout-body :global(p) { margin: 0; }
  .callout-body :global(* + *) { margin-top: 0.5em; }
  .callout-warning { border-left-color: #c98a1b; }
  .callout-warning .callout-title { color: #c98a1b; }
  .callout-tip { border-left-color: #3d8a4f; }
  .callout-tip .callout-title { color: #3d8a4f; }
</style>

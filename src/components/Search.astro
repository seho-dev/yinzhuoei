---
import Icon from './Icon.astro';
interface Props { label: string; hint: string; devOnly: string }
const { label, hint, devOnly } = Astro.props;
const isDev = import.meta.env.DEV;
---
<button type="button" class="search-trigger" data-search-open aria-label={label}>
  <Icon name="search" size={15} />
  <span class="search-label">{label}</span>
  <kbd class="search-kbd">⌘K</kbd>
</button>

<dialog class="search-dialog" data-search-dialog aria-label={label}>
  <div class="search-panel">
    <div id="pagefind-search" data-hint={hint}></div>
    {isDev && <p class="search-dev">{devOnly}</p>}
  </div>
</dialog>

<style is:global>
  /* Pagefind UI theming */
  .pagefind-ui__search-input:focus,
  .pagefind-ui__search-input:focus-visible {
    outline: none !important;
    border-color: var(--accent) !important;
  }
  .pagefind-ui mark {
    background: var(--accent-soft) !important;
    color: var(--accent) !important;
    padding: 0 0.1em;
    border-radius: 2px;
  }
  .pagefind-ui__result-title {
    font-weight: 600 !important;
  }
  .pagefind-ui__result-excerpt {
    color: var(--ink-2);
  }
  .pagefind-ui__message {
    font-weight: 500 !important;
    color: var(--ink-3);
  }
</style>

<style>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2rem;
    padding: 0 0.65rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 0.8125rem;
    color: var(--ink-3);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .search-trigger:hover { color: var(--ink); border-color: var(--line-strong); }
  .search-kbd {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    color: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
  }
  @media (max-width: 560px) {
    .search-label, .search-kbd { display: none; }
    .search-trigger { border: none; width: 2rem; padding: 0; justify-content: center; color: var(--ink-2); }
    .search-trigger:hover { background: var(--bg-subtle); color: var(--ink); }
  }
  .search-dialog {
    position: fixed;
    inset: 0;
    margin: 0;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    background: color-mix(in oklch, var(--ink) 18%, transparent);
    border: none;
    padding: 12vh 1.25rem 1.25rem;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .search-dialog[open] { opacity: 1; }
  .search-dialog::backdrop { background: transparent; }
  .search-panel {
    max-width: 34rem;
    margin: 0 auto;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem;
    box-shadow: 0 24px 60px -12px rgb(0 0 0 / 0.25);
    transform: translateY(8px);
    transition: transform 0.25s var(--ease-out);
    max-height: 70vh;
    overflow-y: auto;
  }
  .search-dialog[open] .search-panel { transform: none; }
  .search-dev {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    color: var(--ink-3);
    text-align: center;
  }
</style>

<script>
  function bindSearch() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
    const openBtn = document.querySelector<HTMLButtonElement>('[data-search-open]');
    if (!dialog || !openBtn || dialog.dataset.bound) return;
    dialog.dataset.bound = '1';

    let loaded = false;
    async function open() {
      dialog!.showModal();
      if (loaded) return;
      loaded = true;
      try {
        // Generated by `pagefind --site dist` during build; absent in dev.
        if (!document.querySelector('link[href="/pagefind/pagefind-ui.css"]')) {
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = '/pagefind/pagefind-ui.css';
          document.head.appendChild(link);
        }
        await new Promise<void>((resolve, reject) => {
          const s = document.createElement('script');
          s.src = '/pagefind/pagefind-ui.js';
          s.onload = () => resolve();
          s.onerror = () => reject(new Error('pagefind ui unavailable'));
          document.head.appendChild(s);
        });
        // @ts-expect-error global from the classic pagefind-ui.js script
        new window.PagefindUI({
          element: '#pagefind-search',
          showSubResults: true,
          showImages: false,
        });
        dialog!.querySelector<HTMLInputElement>('input')?.focus();
      } catch {
        /* dev mode: hint text is shown instead */
      }
    }
    openBtn.addEventListener('click', open);
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        dialog!.open ? dialog!.close() : open();
      }
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
  bindSearch();
  document.addEventListener('astro:page-load', bindSearch);
</script>

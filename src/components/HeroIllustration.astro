---
interface Props {
  caption: string;
}
const { caption } = Astro.props;
---

<figure class="scene reveal" style="--reveal-delay: 300ms">
  <svg
    viewBox="0 0 600 410"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={caption}
  >
    <defs>
      <radialGradient id="afternoon-light">
        <stop stop-color="var(--sc-sun)" stop-opacity="0.17" />
        <stop offset="1" stop-color="var(--sc-sun)" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="meadow-wash" x1="0" y1="0" x2="0" y2="1">
        <stop stop-color="var(--sc-meadow)" stop-opacity="0.16" />
        <stop offset="1" stop-color="var(--sc-meadow)" stop-opacity="0.03" />
      </linearGradient>
      <linearGradient id="path-fade">
        <stop stop-color="var(--sc-meadow)" stop-opacity="0" />
        <stop offset="0.2" stop-color="var(--sc-meadow)" stop-opacity="0.55" />
        <stop offset="0.8" stop-color="var(--sc-meadow)" stop-opacity="0.55" />
        <stop offset="1" stop-color="var(--sc-meadow)" stop-opacity="0" />

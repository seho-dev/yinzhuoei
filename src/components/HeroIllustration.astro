<style>
  .scene {
    --sc-outline: #71523e;
    --sc-detail: #513a2f;
    --sc-skin: #f1d2b9;
    --sc-skin-shade: #d7a98b;
    --sc-man-hair: #40332d;
    --sc-woman-hair: #72503c;
    --sc-hair-light: #b18b68;
    --sc-cream: #fff9ed;
    --sc-shirt: #8297a4;
    --sc-shirt-shade: #6c8290;
    --sc-shirt-cuff: #a3b0b5;
    --sc-trousers: #50565b;
    --sc-trousers-shade: #444b50;
    --sc-dress: #cb6046;
    --sc-dress-shade: #a84c37;
    --sc-flat: #725341;
    --sc-fur: #e6ac61;
    --sc-fur-shade: #c88d4c;
    --sc-white: #fff9ed;
    --sc-ear: #e0ab8c;
    --sc-tongue: #de8b83;
    --sc-sun: #dca448;
    --sc-meadow: #a4a17b;
    --sc-grass: #929777;
    --sc-shadow: #806b48;
    width: 100%;
    margin: 0;
  }

  :global(.dark) .scene {
    --sc-outline: #9b785a;
    --sc-detail: #49372d;
    --sc-skin: #e2b99a;
    --sc-skin-shade: #c99374;
    --sc-man-hair: #44382f;
    --sc-woman-hair: #71523d;
    --sc-hair-light: #ae8967;
    --sc-cream: #e8decb;
    --sc-shirt: #7c919c;
    --sc-shirt-shade: #627884;
    --sc-shirt-cuff: #9caaa9;
    --sc-trousers: #565d60;
    --sc-trousers-shade: #454d51;
    --sc-dress: #c66a4e;
    --sc-dress-shade: #a8553d;
    --sc-flat: #9e7758;
    --sc-fur: #d6a05a;
    --sc-fur-shade: #b38349;
    --sc-white: #eae0cb;
    --sc-ear: #c99779;
    --sc-tongue: #cf857b;
    --sc-sun: #c89548;
    --sc-meadow: #9a936b;
    --sc-grass: #878d6b;
    --sc-shadow: #080706;
  }

  .scene > svg { display: block; width: 100%; height: auto; }
  .scene figcaption {
    margin-top: 0.85rem;
    color: var(--ink-3);
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-style: italic;
    letter-spacing: 0.01em;
    text-align: center;
  }

  .ink { stroke: var(--sc-outline); stroke-width: 1.35; stroke-linecap: round; stroke-linejoin: round; }
  .sun { fill: var(--sc-sun); opacity: 0.8; }
  .sun-rays { stroke: var(--sc-sun); stroke-width: 1.35; stroke-linecap: round; opacity: 0.65; }
  .cloud, .birds { stroke: var(--sc-meadow); stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; }
  .cloud { opacity: 0.65; }
  .birds { opacity: 0.75; }
  .meadow { fill: url(#meadow-wash); }
  .hillside { stroke: var(--sc-meadow); stroke-width: 1; opacity: 0.25; }
  .ground-shadow { fill: var(--sc-shadow); opacity: 0.13; }
  .ground-line { stroke: url(#path-fade); stroke-width: 1.3; }
  .path-marks { stroke: var(--sc-meadow); stroke-width: 1; stroke-linecap: round; opacity: 0.3; }
  .wildflowers { stroke: var(--sc-grass); stroke-width: 1.25; stroke-linecap: round; }
  .flower { fill: var(--sc-cream); stroke: var(--sc-sun); stroke-width: 1.5; }
  .flower-small, .breeze-leaf { fill: var(--sc-sun); stroke: none; opacity: 0.65; }
  .breeze-leaf { fill: var(--sc-grass); }

  .skin { fill: var(--sc-skin); }
  .neck-shadow { fill: var(--sc-skin-shade); stroke: none; opacity: 0.45; }
  .ear-detail, .face-detail, .eye-line, .brow, .hand-detail {
    fill: none;
    stroke: var(--sc-detail);
    stroke-width: 1.05;
  }
  .brow { stroke-width: 1.3; }
  .woman-face .brow, .woman-face .eye-line, .woman-face .face-detail { stroke-width: 0.85; }
  .woman-face .brow { opacity: 0.8; }
  .woman-face .cheek { stroke-width: 2.4; opacity: 0.28; }
  .eye { fill: var(--sc-detail); stroke: none; }
  .cheek { stroke: #cd8872; stroke-width: 2.8; opacity: 0.36; }
  .man-hair { fill: var(--sc-man-hair); }
  .woman-hair { fill: var(--sc-woman-hair); }
  .hair-light { stroke: var(--sc-hair-light); stroke-width: 1; opacity: 0.5; }
  .hair-part { stroke: var(--sc-skin); stroke-width: 0.85; }
  .earring { fill: var(--sc-cream); stroke-width: 0.8; }
  .cream, .sneaker { fill: var(--sc-cream); }
  .tee-neck { stroke: var(--sc-skin-shade); stroke-width: 1.2; }
  .shirt, .shirt-collar { fill: var(--sc-shirt); }
  .shirt-shade { fill: var(--sc-shirt-shade); }
  .shirt-cuff { fill: var(--sc-shirt-cuff); }
  .shirt-detail { stroke: var(--sc-detail); stroke-width: 0.9; opacity: 0.55; }
  .button { fill: var(--sc-cream); stroke: none; }
  .trousers { fill: var(--sc-trousers); }
  .trousers-shade { fill: var(--sc-trousers-shade); }
  .trouser-fold { stroke: var(--sc-cream); stroke-width: 1; opacity: 0.2; }
  .shoe-detail { stroke-width: 0.9; opacity: 0.6; }
  .dress { fill: var(--sc-dress); }
  .dress-fold, .belt-tie { stroke: var(--sc-dress-shade); stroke-width: 1.3; }
  .dress-light { stroke: var(--sc-cream); stroke-width: 1; opacity: 0.25; }
  .dress-belt { fill: var(--sc-dress-shade); stroke: none; }
  .flat { fill: var(--sc-flat); }
  .flat-detail { stroke: var(--sc-cream); stroke-width: 1; opacity: 0.5; }
  .leash, .leash-loop { stroke: var(--sc-dress-shade); stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .leash-loop { stroke-width: 1.5; }

  .fur { fill: var(--sc-fur); }
  .fur-shade { fill: var(--sc-fur-shade); }
  .fur-white { fill: var(--sc-white); }
  .color-patch, .brow-spot, .tail-tip { stroke: none; }
  .inner-ear { fill: var(--sc-ear); stroke-width: 0.9; }
  .bandana { fill: var(--sc-dress); }
  .bandana-fold { stroke: var(--sc-dress-shade); stroke-width: 1; }
  .leash-ring { fill: var(--sc-dress-shade); stroke: var(--sc-cream); stroke-width: 1; }
  .paw-detail { stroke-width: 0.85; opacity: 0.65; }
  .catchlight { fill: #fffaf2; stroke: none; }
  .muzzle-shade { fill: var(--sc-skin-shade); stroke: none; opacity: 0.2; }
  .tongue { fill: var(--sc-tongue); stroke: var(--sc-detail); stroke-width: 0.9; }
  .dog-smile { stroke: var(--sc-detail); stroke-width: 1.05; }
  .nose { fill: var(--sc-detail); stroke: none; }
  .nose-light { stroke: var(--sc-white); stroke-width: 0.85; opacity: 0.6; }

  .walking-leg, .walking-foot, .free-arm { transform-box: view-box; }
  .walking-leg, .walking-foot { animation: walk-step 1.8s ease-in-out infinite; }
  .walking-foot { animation-name: foot-level; }
  .step-opposite, .step-opposite .walking-foot { animation-delay: -0.9s; }

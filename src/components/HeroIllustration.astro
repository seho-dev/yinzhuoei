<style>
  .scene {
    --scene-paper: var(--bg, #faf9f7);
    --scene-ink: var(--ink-2, #57544d);
    --scene-accent: var(--accent, #b3401f);
    margin: 0;
    width: 100%;
  }

  :global(.dark) .scene {
    --scene-paper: var(--bg, #131211);
    --scene-ink: var(--ink-2, #a39e93);
    --scene-accent: var(--accent, #e0683f);
  }

  .scene > svg {
    display: block;
    width: 100%;
    height: auto;
    stroke: var(--scene-ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .scene figcaption {
    margin-top: 0.85rem;
    color: var(--ink-3);
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-style: italic;
    letter-spacing: 0.01em;
    text-align: center;
  }

  .paper { fill: var(--scene-paper); }
  .fine { stroke-width: 1.25; }
  .setting { stroke: var(--ink-3); opacity: 0.65; }
  .sun { stroke-width: 1.5; }
  .ground { opacity: 0.5; }
  .arm, .limb { stroke-width: 2.2; }
  .far-leg { stroke: var(--ink-3); }
  .leg-clear { stroke: var(--scene-paper); stroke-width: 6; }
  .leash { stroke: var(--scene-accent); stroke-width: 1.7; }
  .bandana { fill: var(--scene-accent); stroke: var(--scene-accent); stroke-width: 1; }
  .nose { fill: var(--scene-ink); stroke: none; }

  /* Hip pivots stay covered; shoes counter-rotate and the returning foot lifts. */
  .walking-leg, .walking-shoe, .free-arm, .tail-wag { transform-origin: 0px 0px; }
  .walking-leg { animation: walk 2.4s ease-in-out infinite; }
  .walking-shoe { animation: shoe-level 2.4s ease-in-out infinite; }
  .opposite, .opposite .walking-shoe { animation-delay: -1.2s; }
  .free-arm { animation: arm-swing 2.4s ease-in-out infinite; }
  .tail-wag { animation: tail-wag 0.8s ease-in-out infinite alternate; }

  @keyframes walk {
    0%, 100% { transform: scaleY(1.0223) rotate(-12deg); }
    25% { transform: scaleY(1) rotate(0deg); }
    50% { transform: scaleY(1.0223) rotate(12deg); }
    75% { transform: scaleY(0.91) rotate(0deg); }
  }

  @keyframes shoe-level {
    0%, 100% { transform: rotate(12deg); }
    25%, 75% { transform: rotate(0deg); }
    50% { transform: rotate(-12deg); }
  }

  @keyframes arm-swing {
    0%, 100% { transform: rotate(-7deg); }
    50% { transform: rotate(7deg); }
  }

  @keyframes tail-wag {
    from { transform: rotate(-8deg); }
    to { transform: rotate(12deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene svg * { animation: none !important; }
    .walking-leg { transform: scaleY(1.01) rotate(-8deg); }
    .walking-shoe { transform: rotate(8deg); }
    .opposite { transform: scaleY(1.01) rotate(8deg); }
    .opposite .walking-shoe { transform: rotate(-8deg); }
  }
</style>

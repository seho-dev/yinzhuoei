---
import type { Post } from '../lib/posts';
import { postSlug, minutesRead, postCategories, postViews, formatViews } from '../lib/posts';
import { localePath, formatDate, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  post: Post;
  lang: Lang;
  showYear?: boolean;
  showViews?: boolean;
}
const { post, lang, showYear = false, showViews = true } = Astro.props;
const t = useTranslations(lang);
const href = localePath(lang, `/blog/${postSlug(post)}`);
const categories = postCategories(post);
const views = postViews(post);
const viewsFormatted = formatViews(views);
---
<a
  href={href}
  class="post-row reveal"
  data-post-row
  data-categories={categories.join(',')}
  data-pagefind-filter={`lang:${lang}`}
>
  <span class="row-date">
    {showYear
      ? formatDate(post.data.date, lang)
      : post.data.date.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { month: 'short', day: 'numeric' })}
  </span>
  <span class="row-main">
    <span class="row-title">{post.data.title}</span>
    <span class="row-desc">{post.data.description}</span>
  </span>
  <span class="row-meta">
    {showViews && (
      <span class="row-views" title={`${viewsFormatted} ${t('blog.views')}`}>
        <Icon name="eye" size={13} />
        <span>{viewsFormatted}</span>
      </span>
    )}
    <span class="row-read">{minutesRead(post)} {t('blog.minRead')}</span>
    <Icon name="arrow-up-right" size={15} class="row-arrow" />
  </span>
</a>

<style is:global>
  .post-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.1rem 0.5rem;
    margin: 0 -0.5rem;
    border-bottom: 1px solid var(--line);
    border-radius: 6px;
    transition: background-color 0.2s ease;
  }
  .post-row:hover { background: var(--bg-subtle); }
  .row-date {
    font-size: 0.8125rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .row-main { min-width: 0; }
  .row-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.4;
    transition: color 0.2s ease;
  }
  .post-row:hover .row-title { color: var(--accent); }
  .row-desc {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .row-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .row-views {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-variant-numeric: tabular-nums;
  }
  .row-arrow { transition: transform 0.25s var(--ease-out); }
  .post-row:hover .row-arrow { transform: translate(2px, -2px); color: var(--accent); }
  @media (max-width: 640px) {
    .post-row { grid-template-columns: 1fr auto; gap: 0.25rem 0.75rem; }
    .row-date { grid-column: 1 / -1; font-size: 0.75rem; }
    .row-read { display: none; }
  }
</style>

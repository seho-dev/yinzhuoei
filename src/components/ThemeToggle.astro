---
import Icon from './Icon.astro';
interface Props { label: string }
const { label } = Astro.props;
---
<button type="button" class="theme-toggle" data-theme-toggle aria-label={label} title={label}>
  <span class="icon-sun"><Icon name="sun" size={16} /></span>
  <span class="icon-moon"><Icon name="moon" size={16} /></span>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 6px;
    color: var(--ink-2);
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .theme-toggle:hover { color: var(--ink); background: var(--bg-subtle); }
  .icon-sun, .icon-moon { grid-area: 1 / 1; display: grid; place-items: center; transition: opacity 0.25s ease, transform 0.35s var(--ease-out); }
  :global(.dark) .icon-sun { opacity: 0; transform: rotate(90deg) scale(0.6); }
  :global(html:not(.dark)) .icon-moon { opacity: 0; transform: rotate(-90deg) scale(0.6); }
</style>

<script>
  function bind() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      });
    });
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
